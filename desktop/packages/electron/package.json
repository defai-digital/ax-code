{
  "name": "@ax-code/electron",
  "version": "7.6.4",
  "private": true,
  "description": "AX Code — Electron desktop shell",
  "author": "DEFAI Private Limited",
  "homepage": "https://github.com/defai-digital/ax-code",
  "desktopName": "ax-code-desktop.desktop",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:web-assets": "pnpm --filter ax-code-desktop run build && node scripts/copy-web-assets.mjs",
    "bundle:main": "node scripts/bundle-main.mjs",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "build": "pnpm run build:web-assets && pnpm run bundle:main && pnpm run rebuild:native",
    "type-check": "node ../../scripts/check-electron-runtime.mjs",
    "lint": "eslint \"./src/**/*.{js,mjs}\" \"./scripts/**/*.{js,mjs}\" --config ../../eslint.config.js",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "42.5.2",
    "electron-builder": "catalog:",
    "esbuild": "^0.24.2"
  }
}
