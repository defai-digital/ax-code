{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ax-code/ax-code-intel",
  "version": "0.1.0",
  "description": "Language Server Protocol client and server orchestration for AX Code",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./index-impl": "./src/index-impl.ts",
    "./host": "./src/host.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./server-config": "./src/server-config.ts",
    "./server-profile": "./src/server-profile.ts",
    "./server-defs": "./src/server-defs/index.ts",
    "./server-releases": "./src/server-releases.ts",
    "./server-helpers": "./src/server-helpers.ts",
    "./language": "./src/language.ts",
    "./prewarm-profile": "./src/prewarm-profile.ts",
    "./prewarm": "./src/prewarm.ts",
    "./launch": "./src/launch.ts",
    "./scheduler": "./src/scheduler.ts",
    "./selection": "./src/selection.ts",
    "./broken-server": "./src/broken-server.ts",
    "./client-notify": "./src/client-notify.ts",
    "./envelope": "./src/envelope.ts",
    "./envelope-runner": "./src/envelope-runner.ts",
    "./cache-context": "./src/cache-context.ts",
    "./cache-probe": "./src/cache-probe.ts",
    "./perf": "./src/perf.ts",
    "./protocol": "./src/protocol.ts",
    "./point": "./src/point.ts",
    "./references": "./src/references.ts",
    "./diagnostics": "./src/diagnostics.ts",
    "./document-symbol": "./src/document-symbol.ts",
    "./workspace-symbol": "./src/workspace-symbol.ts",
    "./semantic-results": "./src/semantic-results.ts",
    "./oxlint": "./src/oxlint.ts",
    "./jdtls-data-dir": "./src/jdtls-data-dir.ts",
    "./internal/log": "./src/internal/log.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ax-code/util": "workspace:*",
    "cross-spawn": "^7.0.6",
    "diff": "catalog:",
    "fast-glob": "catalog:",
    "mime-types": "3.0.2",
    "minimatch": "10.2.3",
    "vscode-jsonrpc": "8.2.1",
    "vscode-languageserver-types": "3.17.5",
    "which": "6.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/mime-types": "catalog:",
    "@types/node": "catalog:",
    "@types/which": "3.0.4",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  }
}
