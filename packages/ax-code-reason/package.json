  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.ts",
    "./id": "./src/id.ts",
    "./query": "./src/query.ts",
    "./repository": "./src/repository.ts",
    "./schema.sql": "./src/schema.sql.ts",
    "./runtime-debug": "./src/runtime-debug.ts",
    "./analyze-bug": "./src/analyze-bug.ts",
    "./analyze-impact": "./src/analyze-impact.ts",
    "./detect-duplicates": "./src/detect-duplicates.ts",
    "./diagnostic-correlation": "./src/diagnostic-correlation.ts",
    "./language-scan": "./src/language-scan.ts",
    "./native-scan": "./src/native-scan.ts",
    "./plan-refactor": "./src/plan-refactor.ts",
    "./prewarm-lsp": "./src/prewarm-lsp.ts",
    "./scanner-utils": "./src/scanner-utils.ts",
