{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "7.24.2",
  "name": "ax-code",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "knip": "knip --no-progress --treat-config-hints-as-errors",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "tsx script/test-groups.ts unit",
    "test:recovery": "tsx script/test-groups.ts recovery",
    "test:e2e": "tsx script/test-groups.ts e2e",
    "test:deterministic": "tsx script/test-groups.ts deterministic",
    "test:live": "tsx script/test-groups.ts live",
    "test:tui-renderer": "tsx script/test-groups.ts tui-renderer",
    "test:ci": "tsx script/test-ci.ts",
    "test:risk": "tsx script/test-risk.ts",
    "check:skills": "tsx script/check-skills.ts",
    "check:skills:all": "tsx script/check-skills.ts --all",
    "check:wiki-visualization": "node ../../script/node-ffi-runner.mjs --import tsx --import ../../script/solid-loader.mjs --conditions=node script/check-wiki-visualization-render.tsx",
    "check:webmcp-allowlist": "node ../../script/node-ffi-runner.mjs --import tsx --import ../../script/solid-loader.mjs --conditions=node script/check-webmcp-allowlist-render.tsx",
    "check:tui-layering": "tsx script/check-tui-layering.ts",
    "check:fixed-context-dialog": "node ../../script/node-ffi-runner.mjs --import tsx --import ../../script/solid-loader.mjs --conditions=node script/check-fixed-context-dialog.tsx",
    "check:prompt-footer": "node ../../script/node-ffi-runner.mjs --import tsx --import ../../script/solid-loader.mjs --conditions=node script/check-prompt-footer-render.tsx",
    "check:transcript-code-render": "node ../../script/node-ffi-runner.mjs --import tsx --import ../../script/solid-loader.mjs --conditions=node script/check-transcript-code-render.tsx",
    "check:session-tree-memo": "node ../../script/node-ffi-runner.mjs --import tsx --import ../../script/solid-loader.mjs --conditions=node script/check-session-tree-memo.ts",
    "check:tui-snapshot": "node ../../script/node-ffi-runner.mjs --import tsx --import ../../script/solid-loader.mjs --conditions=node script/check-tui-snapshot.ts",
    "check:golden-frames": "node ../../script/node-ffi-runner.mjs --import tsx --conditions=node script/check-golden-frames.ts",
    "check:bun-compat": "tsx script/check-bun-compat.ts",
    "check:bare-json-parse": "tsx script/check-bare-json-parse.ts",
    "check:self-scan": "tsx script/self-scan.ts",
    "quality:rollout": "node ../../script/node-ffi-runner.mjs --import tsx --import ../../script/solid-loader.mjs --conditions=node script/quality-rollout.ts",
    "perf:index": "tsx script/perf-index.ts",
    "perf:report": "tsx script/perf-report.ts",
    "build": "tsx script/build-node-tui.ts",
    "build:node": "tsx script/build-node.ts",
    "build:node-tui": "tsx script/build-node-tui.ts",
    "tui:startup-smoke": "tsx script/tui-startup-smoke.ts",
    "dev": "node ../../script/node-ffi-runner.mjs --import tsx --import ../../script/solid-loader.mjs --conditions=node ./src/index-node-tui.ts",
    "db": "pnpm exec drizzle-kit",
    "check:tui-locales": "tsx script/check-tui-locales.ts && node ../../script/node-ffi-runner.mjs --import tsx --import ../../script/solid-loader.mjs --conditions=node script/check-tui-locales-render.tsx"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "imports": {
    "#db": {
      "node": "./src/storage/db.node.ts",
      "default": "./src/storage/db.node.ts"
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ax-code/script": "workspace:*",
    "@octokit/webhooks-types": "catalog:",
    "@parcel/watcher-darwin-arm64": "2.6.0",
    "@parcel/watcher-linux-arm64-glibc": "2.6.0",
    "@parcel/watcher-linux-arm64-musl": "2.6.0",
    "@parcel/watcher-linux-x64-glibc": "2.6.0",
    "@parcel/watcher-linux-x64-musl": "2.6.0",
    "@parcel/watcher-win32-arm64": "2.6.0",
    "@parcel/watcher-win32-x64": "2.6.0",
    "@types/cross-spawn": "6.0.6",
    "@types/mime-types": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@types/turndown": "5.0.6",
    "@types/which": "3.0.4",
    "@types/ws": "^8.18.2",
    "@types/yargs": "17.0.35",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "esbuild": "^0.28.1",
    "knip": "^6.39.0",
    "playwright-core": "catalog:",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@actions/core": "catalog:",
    "@actions/github": "catalog:",
    "@agentclientprotocol/sdk": "0.14.1",
    "@ai-sdk/google": "3.0.57",
    "@ai-sdk/openai": "^3.0.50",
    "@ai-sdk/openai-compatible": "2.0.38",
    "@ai-sdk/provider": "3.0.8",
    "@ax-code/ax-agent-runtime": "workspace:*",
    "@ax-code/ax-code-intel": "workspace:*",
    "@ax-code/ax-code-reason": "workspace:*",
    "@ax-code/ax-wiki": "workspace:*",
    "@ax-code/ax-wiki-viewer": "workspace:*",
    "@ax-code/computer": "workspace:*",
    "@ax-code/diff": "workspace:*",
    "@ax-code/fs": "workspace:*",
    "@ax-code/index-core": "workspace:*",
    "@ax-code/parser": "workspace:*",
    "@ax-code/plugin": "workspace:*",
    "@ax-code/script": "workspace:*",
    "@ax-code/sdk": "workspace:*",
    "@ax-code/util": "workspace:*",
    "@clack/prompts": "1.8.1",
    "@hono/node-server": "^2.0.5",
    "@hono/node-ws": "^1.3.1",
    "@hono/standard-validator": "^0.2.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@msgpack/msgpack": "3.1.3",
    "@octokit/graphql": "catalog:",
    "@octokit/rest": "catalog:",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@parcel/watcher": "2.6.0",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "@solid-primitives/event-bus": "1.1.4",
    "@solid-primitives/scheduled": "1.5.3",
    "@standard-schema/spec": "catalog:",
    "@zip.js/zip.js": "2.7.62",
    "ai": "catalog:",
    "ai-gateway-provider": "3.1.3",
    "ax-tui": "catalog:",
    "bonjour-service": "1.4.4",
    "clipboardy": "4.0.0",
    "cross-spawn": "^7.0.6",
    "diff": "catalog:",
    "drizzle-orm": "catalog:",
    "fast-glob": "catalog:",
    "fuzzysort": "catalog:",
    "gray-matter": "4.0.3",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "ignore": "7.0.12",
    "jsonc-parser": "3.3.1",
    "mime-types": "3.0.2",
    "minimatch": "10.2.6",
    "node-pty-prebuilt-multiarch": "0.10.1-pre.5",
    "open": "10.1.2",
    "pino": "^10.4.0",
    "remeda": "catalog:",
    "semver": "catalog:",
    "solid-js": "catalog:",
    "strip-ansi": "catalog:",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "turndown": "7.2.4",
    "ulid": "catalog:",
    "vscode-jsonrpc": "8.2.1",
    "web-tree-sitter": "0.25.10",
    "which": "6.0.1",
    "ws": "^8.22.0",
    "xdg-basedir": "5.1.0",
    "yargs": "18.2.0",
    "zod": "catalog:",
    "zod-to-json-schema": "catalog:"
  },
  "overrides": {
    "drizzle-orm": "catalog:"
  }
}
