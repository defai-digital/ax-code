#!/usr/bin/env bash
set -euo pipefail

# Bump the extension version (patch by default, --minor for a minor bump),
# commit it, tag vscode-v<version>, and push the commit and tag.

minor=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --minor) minor=true; shift 1;;
    *) echo "Unknown parameter: $1"; exit 1;;
  esac
done

cd "$(dirname "$0")/.."

if [ "$minor" = true ]; then
  bump="minor"
else
  bump="patch"
fi

new_version=$(pnpm version "$bump" --no-git-tag-version)
new_version="${new_version#v}"
echo "New version: $new_version"

git add package.json
git commit -m "chore(vscode): release $new_version"
git tag "vscode-v$new_version"
git push origin HEAD "vscode-v$new_version"
