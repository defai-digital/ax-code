#!/usr/bin/env bash
set -euo pipefail

# Package and publish the VS Code extension (marketplace extension ID
# AutomatosX.ax-code-vscode). The version comes from package.json — bump it first
# via script/release.

cd "$(dirname "$0")/.."

version=$(node -p "require('./package.json').version")
echo "Publishing ax-code $version"

# Build the production bundle and package the VSIX (dist/ax-code-$version.vsix).
bash script/package-vsix

# publish-marketplace
./node_modules/.bin/vsce publish --packagePath "dist/ax-code-$version.vsix"

# publish-openvsx (optional — skipped when no token is configured)
if [ -n "${OPENVSX_TOKEN:-}" ]; then
  pnpm dlx ovsx publish "dist/ax-code-$version.vsix" -p "$OPENVSX_TOKEN"
else
  echo "OPENVSX_TOKEN not set — skipping Open VSX publish"
fi
