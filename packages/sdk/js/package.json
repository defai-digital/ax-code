{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ax-code/sdk",
  "version": "2.2.3",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "validate:openapi": "tsx ./script/validate-openapi.ts",
    "build": "tsx ./script/build.ts",
    "test": "vitest run",
    "check:jsr": "tsx ./script/jsr-publish.ts --dry-run",
    "publish:jsr": "tsx ./script/jsr-publish.ts"
  },
  "exports": {
    ".": "./dist/index.js",
    "./testing": "./dist/testing/index.js",
    "./programmatic": "./dist/programmatic/index.js",
    "./grpc": "./dist/grpc.js",
    "./grpc/node": "./dist/grpc-node.js",
    "./headless": "./dist/headless.js",
    "./headless-ipc": "./dist/headless-ipc.js",
    "./headless/client": "./dist/headless/client.js",
    "./headless/event": "./dist/headless/event.js",
    "./headless/projection": "./dist/headless/projection.js",
    "./mode": "./dist/mode.js",
    "./provider-connect": "./dist/provider-connect.js",
    "./v2": "./dist/v2/index.js",
    "./v2/client": "./dist/v2/client.js",
    "./v2/gen/client": "./dist/v2/gen/client/index.js",
    "./v2/server": "./dist/v2/server.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "jsr": "catalog:",
    "tsx": "4.22.4",
    "typescript": "catalog:",
    "vitest": "4.1.9"
  }
}
