{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": [
      "node",
      "bun"
    ],
    "lib": [
      "ESNext",
      "DOM"
    ],
    "newLine": "lf"
  },
  "include": [
    "src"
  ]
}
