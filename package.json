{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "ax-code",
  "description": "AI-powered development tool",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "workspaces": [
    "packages/*",
    "packages/sdk/js"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm --dir packages/ax-code exec node ../../script/node-ffi-runner.mjs --optional-env-file=../../.env --import tsx --import ../../script/solid-loader.mjs --conditions=node src/index-node-tui.ts",
    "cli": "pnpm --dir packages/ax-code exec node ../../script/node-ffi-runner.mjs --import tsx --import ../../script/solid-loader.mjs --conditions=node src/index-node-tui.ts",
    "setup:cli": "tsx script/setup-cli.ts",
    "check:structure": "tsx script/structure.ts",
    "check:no-cost": "tsx script/check-no-cost.ts",
    "check:openapi": "pnpm --dir packages/sdk/js run validate:openapi",
    "check:sdk-jsr": "pnpm --dir packages/sdk/js run build && pnpm --dir packages/sdk/js run check:jsr",
    "check:self-scan": "pnpm --dir packages/ax-code run check:self-scan",
    "release:cli": "pnpm run publish:github",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build:native": "tsx script/build-native.ts",
    "build:native:debug": "tsx script/build-native.ts --debug",
    "check:tui": "pnpm --dir packages/ax-code run check:tui-layering && pnpm --dir packages/ax-code run check:tui-snapshot",
    "perf:intel": "tsx packages/ax-code-intel/perf/src/harness.ts",
    "perf:intel:smoke": "tsx packages/ax-code-intel/perf/src/harness.ts --scenario smoke",
    "perf:intel:full": "tsx packages/ax-code-intel/perf/src/harness.ts --scenario full --record",
    "publish:github": "tsx script/publish-github-release.ts",
    "sign:release": "tsx script/sign-release-assets.ts",
    "winget:generate": "tsx tools/winget/generate-manifests.ts",
    "prepare": "husky",
    "postinstall": "node script/fix-node-pty-permissions.mjs",
    "test:extracted-packages": "pnpm --dir packages/ax-code-intel typecheck && pnpm --dir packages/ax-code-intel test && pnpm --dir packages/ax-code-reason typecheck && pnpm --dir packages/ax-code-reason test",
    "test:scripts": "vitest run",
    "test": "echo 'do not run tests from root (use test:scripts for root script suites)' && exit 1"
  },
  "devDependencies": {
    "@actions/artifact": "5.0.1",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "husky": "9.1.7",
    "prettier": "3.6.2",
    "tsx": "^4.22.4",
    "turbo": "2.9.14",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "@ax-code/plugin": "workspace:*",
    "@ax-code/script": "workspace:*",
    "@ax-code/sdk": "workspace:*",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/defai-digital/ax-code"
  },
  "license": "Apache-2.0",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "@ax-code/diff",
    "@ax-code/fs",
    "@ax-code/index-core",
    "@ax-code/terminal",
    "@ax-code/parser",
    "esbuild",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "node-pty-prebuilt-multiarch",
    "web-tree-sitter"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty-prebuilt-multiarch"
    ],
    "overrides": {
      "serialize-javascript": ">=7.0.5",
      "seroval": ">=1.5.3",
      "diff@<8.0.3": "8.0.3",
      "undici@<6.28.0": "6.28.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "tar@<7.5.21": "7.5.21",
      "@hono/node-server@<2.0.11": "2.0.11",
      "hono@>=4.0.0 <4.12.34": "4.12.34",
      "postcss@<8.5.23": "8.5.23",
      "fast-xml-parser@<5.7.0": "5.7.0",
      "protobufjs@<7.6.5": "7.6.5",
      "@protobufjs/utf8@<1.1.1": "1.1.1",
      "fast-uri@<3.1.6": "3.1.6",
      "@humanfs/node@<0.16.8": "0.16.8",
      "browserslist@<4.28.7": "4.28.7",
      "fast-xml-builder@<1.1.7": "1.1.7",
      "ws@<8.21.0": "8.21.0",
      "prismjs@<1.30.0": "1.30.0",
      "brace-expansion@<5.0.9": "5.0.9",
      "ip-address@<10.3.1": "10.3.1",
      "qs@<6.16.0": "6.16.0",
      "uuid@<14.0.0": "14.0.0",
      "tmp@<0.2.7": "0.2.7",
      "esbuild@<0.28.1": "0.28.1",
      "markdown-it@<14.2.0": "14.2.0",
      "@opentelemetry/core@<2.8.0": "2.8.0",
      "form-data@<4.0.6": "4.0.6",
      "js-yaml@<4.3.1": "4.3.1",
      "@babel/core@<7.29.6": "7.29.6",
      "linkify-it@<5.0.2": "5.0.2",
      "shell-quote@<1.9.0": "1.9.0",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "dompurify@<3.4.13": "3.4.13",
      "builder-util-runtime@<9.7.0": "9.7.0",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18"
    },
    "peerDependencyRules": {},
    "patchedDependencies": {
      "@standard-community/standard-openapi@0.2.9": "patches/@standard-community%2Fstandard-openapi@0.2.9.patch",
      "gray-matter@4.0.3": "patches/gray-matter@4.0.3.patch",
      "@msgpack/msgpack@3.1.3": "patches/@msgpack__msgpack@3.1.3.patch",
      "brace-expansion@5.0.9": "patches/brace-expansion@5.0.9.patch",
      "node-pty-prebuilt-multiarch@0.10.1-pre.5": "patches/node-pty-prebuilt-multiarch@0.10.1-pre.5.patch"
    }
  }
}
