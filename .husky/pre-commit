#!/usr/bin/env sh

# Secret scanning — abort commit if staged files contain API keys or tokens.
# Patterns cover common AI provider keys, AWS, GCP, and generic token formats.
SECRET_VALUE_PATTERNS='(sk-[a-zA-Z0-9]{20,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|ghp_[a-zA-Z0-9]{36}|xoxb-[0-9]{10,}-[a-zA-Z0-9]{24,}|-----BEGIN (RSA |EC |DSA )?PRIVATE KEY-----)'
SECRET_ASSIGNMENT_PATTERNS='(ANTHROPIC_API_KEY|OPENAI_API_KEY|GOOGLE_API_KEY)[[:space:]]*[=:][[:space:]]*["'\'']?[a-zA-Z0-9_/+=.-]{20,}'
if git diff --cached --diff-filter=d -U0 |
  grep -E '^\+' |
  grep -vE '^\+\+\+' |
  grep -qE "($SECRET_VALUE_PATTERNS|$SECRET_ASSIGNMENT_PATTERNS)"; then
  echo "ERROR: Possible secret detected in staged changes."
  echo "Review added lines in: git diff --cached -U0"
  echo "If this is a false positive, commit with --no-verify."
  exit 1
fi

# Local-only path guard: `.internal/` and the root agent-instruction files
# (AGENTS.md, CLAUDE.md, GEMINI.md) must never be committed or pushed to
# GitHub. `.gitignore` blocks a plain `git add`, but `git add -f` bypasses it,
# and on a public repo a pushed commit is already public before CI can react --
# so block it locally.
# Uses the same command and pathspecs as script/check-tracked-internal.ts
# (LOCAL_ONLY_PATHSPECS in script/repository-policy.ts, the authoritative CI
# guard) so the two cannot drift apart.
# A nested `AGENTS.md` (e.g. packages/ax-code/test/AGENTS.md) is a legitimate
# tracked fixture and is intentionally not matched.
LOCAL_ONLY_TRACKED=$(git ls-files -- .internal AGENTS.md CLAUDE.md GEMINI.md)
if [ -n "$LOCAL_ONLY_TRACKED" ]; then
  echo "ERROR: local-only paths are tracked and must never be committed or pushed:"
  printf '%s\n' "$LOCAL_ONLY_TRACKED" | sed 's/^/  - /'
  echo "Unstage them with: git rm --cached -- <path>"
  echo "These paths are gitignored; do not force-add them."
  exit 1
fi

# Session dumps and user runtime config. GitHub secret scanning has already
# flagged branded SessionIDs in historical session-ses_*.md files as generic
# passwords; keep them untracked going forward.
LOCAL_DUMP_TRACKED=$(git ls-files -- ':(glob)session-ses_*.md' ':(glob)**/session-ses_*.md' 'ax-code.json' ':(glob)**/ax-code.json')
if [ -n "$LOCAL_DUMP_TRACKED" ]; then
  echo "ERROR: local dump/config files are tracked and must never be committed or pushed:"
  printf '%s\n' "$LOCAL_DUMP_TRACKED" | sed 's/^/  - /'
  echo "Unstage them with: git rm --cached -- <path>"
  echo "These paths are gitignored; do not force-add them."
  exit 1
fi

# The models snapshot is no longer regenerated on every commit. Freshness is
# enforced by the scheduled `.github/workflows/models-drift.yml` job, which
# runs `tsx script/update-models.ts --check` and fails on drift. Regenerate
# manually with: pnpm --dir packages/ax-code exec tsx script/update-models.ts
