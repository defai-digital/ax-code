@@ -0,0 +1,72 @@
+import { expect, test } from "vitest"
+import { DatabaseSync } from "node:sqlite"
+import { Session } from "../../src/session"
+import { SessionID } from "../../src/session/schema"
+import { Instance } from "../../src/project/instance"
+import { Database, eq } from "../../src/storage/db"
+import { SessionTable } from "../../src/session/session.sql"
+import { DurableStoragePolicy } from "../../src/storage/policy"
+import { Bus } from "../../src/bus"
+import { tmpdir } from "../fixture/fixture"
+
+test("session creation recovers after a competing SQLite writer releases its lock", async () => {
+  await using tmp = await tmpdir()
+  await Instance.provide({
+    directory: tmp.path,
+    fn: async () => {
+      const db = Database.Client()
+      const writer = new DatabaseSync(Database.Path)
+      const id = SessionID.descending()
+      const events: Session.Info[] = []
+      const unsubscribe = Bus.subscribe(Session.Event.Created, (event) => {
+        events.push(event.properties.info)
+      })
+      // Force the first attempt to encounter real SQLITE_BUSY, then release
+      // the competing connection while creation yields between attempts.
+      db.run("PRAGMA busy_timeout = 1")
+      writer.exec("BEGIN IMMEDIATE")
+      const release = setTimeout(() => writer.exec("ROLLBACK"), 0)
+      try {
+        const session = await Session.createNext({ id, directory: tmp.path })
+        expect(session.id).toBe(id)
+        expect(await Session.get(id)).toEqual(session)
+        expect(events.map((event) => event.id)).toEqual([id])
+        expect(db.select().from(SessionTable).where(eq(SessionTable.id, id)).all()).toHaveLength(1)
+      } finally {
+        clearTimeout(release)
+        writer.close()
+        db.run(`PRAGMA busy_timeout = ${DurableStoragePolicy.busyTimeoutMs}`)
+        unsubscribe()
+        await Instance.dispose()
+      }
+    },
+  })
+})
+
+test("persistent lock failure leaves no session and emits no created event", async () => {
+  await using tmp = await tmpdir()
+  await Instance.provide({
+    directory: tmp.path,
+    fn: async () => {
+      const db = Database.Client()
+      const writer = new DatabaseSync(Database.Path)
+      const id = SessionID.descending()
+      const events: string[] = []
+      const unsubscribe = Bus.subscribe(Session.Event.Created, (event) => {
+        events.push(event.properties.info.id)
+      })
+      db.run("PRAGMA busy_timeout = 1")
+      writer.exec("BEGIN IMMEDIATE")
+      try {
+        await expect(Session.createNext({ id, directory: tmp.path })).rejects.toThrow("database is locked")
+        expect(db.select().from(SessionTable).where(eq(SessionTable.id, id)).all()).toHaveLength(0)
+        expect(events).toEqual([])
+      } finally {
+        writer.close()
+        db.run(`PRAGMA busy_timeout = ${DurableStoragePolicy.busyTimeoutMs}`)
+        unsubscribe()
+        await Instance.dispose()
+      }
+    },
+  })
+})
