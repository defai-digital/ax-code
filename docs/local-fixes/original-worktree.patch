+import { afterEach, expect, test } from "vitest"
+import fs from "fs/promises"
+import path from "path"
+import { Config } from "../../src/config/config"
+import { Global } from "../../src/global"
+import { Instance } from "../../src/project/instance"
+import { getDoctorConfiguration, getConfiguredCredentialProviders } from "../../src/cli/cmd/doctor-config"
+import { tmpdir } from "../fixture/fixture"
+
+const original = Global.Path.config
+afterEach(async () => {
+  await Instance.disposeAll()
+  ;(Global.Path as { config: string }).config = original
+  Config.global.reset()
+})
+
+test.each(["ax-code.json", "ax-code.jsonc"])(
+  "standalone doctor loads global %s and inline credentials",
+  async (filename) => {
+    await using global = await tmpdir()
+    await using project = await tmpdir()
+    ;(Global.Path as { config: string }).config = global.path
+    Config.global.reset()
+    await fs.writeFile(
+      path.join(global.path, filename),
+      JSON.stringify({ provider: { custom: { options: { apiKey: "test-only-secret" }, models: {} } } }),
+    )
+    const result = await getDoctorConfiguration(project.path)
+    expect(result.check.status).toBe("ok")
+    expect(result.check.detail).toContain("1 provider")
+    expect(getConfiguredCredentialProviders(result.config)).toEqual(["custom"])
+    expect(result.check.detail).not.toContain("test-only-secret")
+  },
+)
+
+test("invalid global configuration is a load failure, not missing configuration", async () => {
+  await using project = await tmpdir()
+  await using global = await tmpdir()
+  ;(Global.Path as { config: string }).config = global.path
+  Config.global.reset()
+  await fs.writeFile(path.join(global.path, "ax-code.json"), '{ "provider": secret-invalid-json')
+  const result = await getDoctorConfiguration(project.path)
+  expect(result.check.status).toBe("fail")
+  expect(result.config).toBeUndefined()
+  expect(result.check.detail).not.toContain("secret-invalid-json")
+})
+
+test("untrusted project credentials do not override effective global credentials", async () => {
+  await using global = await tmpdir()
+  await using project = await tmpdir()
+  ;(Global.Path as { config: string }).config = global.path
+  Config.global.reset()
+  await fs.writeFile(
+    path.join(global.path, "ax-code.json"),
+    JSON.stringify({ provider: { custom: { options: { apiKey: "global-test-key" } } } }),
+  )
+  await fs.writeFile(
+    path.join(project.path, "ax-code.jsonc"),
+    '{ // project override\n "provider": {"custom": {"options": {"apiKey": ""}}}}',
+  )
+  const result = await getDoctorConfiguration(project.path)
+  expect(result.check.status).toBe("ok")
+  expect(getConfiguredCredentialProviders(result.config)).toEqual(["custom"])
+})
+
+test("missing, whitespace and non-string credentials are not counted", () => {
+  expect(getConfiguredCredentialProviders()).toEqual([])
+  expect(
+    getConfiguredCredentialProviders({
+      provider: { a: { options: { apiKey: " " } }, b: { options: { apiKey: 123 } }, c: {} },
+    } as any),
+  ).toEqual([])
+})
