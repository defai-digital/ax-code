@@ -0,0 +1,10 @@
+import { DurableStoragePolicy } from "../storage/policy"
+
+export const SESSION_CREATE_RETRY = { attempts: 3, baseMs: 50, maxMs: 1_000 } as const
+
+// Creation can wait for a competing CLI/desktop writer on every attempt.
+// Keep the UI deadline beyond that entire window, including RPC overhead.
+export const SESSION_CREATE_TIMEOUT_MS =
+  SESSION_CREATE_RETRY.attempts * DurableStoragePolicy.busyTimeoutMs +
+  (SESSION_CREATE_RETRY.attempts - 1) * SESSION_CREATE_RETRY.maxMs +
+  10_000
diff --git a/packages/ax-code/src/snapshot/windows-paths.ts b/packages/ax-code/src/snapshot/windows-paths.ts
new file mode 100644
--- /dev/null
+++ b/packages/ax-code/src/snapshot/windows-paths.ts
@@ -0,0 +1,29 @@
+// Windows resolves these path components as devices, including when an
+// extension is present. Git cannot safely index them through normal paths.
+const RESERVED = /^(?:con|prn|aux|nul|com[1-9¹²³]|lpt[1-9¹²³])(?:\.|$)/i
+
+export function isWindowsReservedPath(file: string): boolean {
+  return file.split(/[\\/]/).some((part) => RESERVED.test(part.replace(/[ .]+$/, "")))
+}
+
+export function snapshotPathspecs(excluded: string[]): string[] {
+  // Literal pathspecs prevent user-controlled filenames from becoming Git
+  // patterns. Excluding a directory component also excludes its descendants.
+  return [".", ...excluded.map((file) => `:(top,exclude,literal)${file}`)]
+}
+
+// `git ls-files -t -z --cached --others --exclude-standard` labels each
+// untracked path with '?' and tracked paths with H/S/M. Parse NUL records so
+// whitespace, newlines and Git pathspec characters remain literal filenames.
+export function inspectWindowsSnapshotPaths(output: string): { indexed: string[]; excluded: string[] } {
+  const indexed = new Set<string>()
+  const excluded = new Set<string>()
+  for (const record of output.split("\0")) {
+    if (!record) continue
+    if (!/^[HSM?] /.test(record) || record.length < 3) throw new Error("Invalid snapshot path inspection output")
+    const file = record.slice(2)
+    if (!isWindowsReservedPath(file)) continue
+    ;(record[0] === "?" ? excluded : indexed).add(file)
+  }
+  return { indexed: [...indexed], excluded: [...excluded] }
+}
