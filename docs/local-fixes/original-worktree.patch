+import { expect, test } from "vitest"
+import fs from "node:fs/promises"
+import path from "node:path"
+import { execFileSync } from "node:child_process"
+import { inspectWindowsSnapshotPaths, isWindowsReservedPath } from "../../src/snapshot/windows-paths"
+import { Snapshot } from "../../src/snapshot"
+import { Instance } from "../../src/project/instance"
+import { Global } from "../../src/global"
+import { Bus } from "../../src/bus"
+import { NotificationEvent } from "../../src/notification/events"
+import { tmpdir } from "../fixture/fixture"
+
+const reserved = [
+  "NUL",
+  "CON",
+  "PRN",
+  "AUX",
+  ...["COM", "LPT"].flatMap((prefix) => Array.from({ length: 9 }, (_, i) => `${prefix}${i + 1}`)),
+  ...["COM", "LPT"].flatMap((prefix) => ["¹", "²", "³"].map((digit) => prefix + digit)),
+  "nul",
+  "con.txt",
+  "PRN.log",
+  "AUX.json",
+  "NUL.txt",
+  "COM1.txt",
+  "LPT9.log",
+  "nested/CON",
+]
+const valid = ["normal.txt", "CONSOLE.txt", "AUXILIARY.txt", "COM10", "LPT10", "null"]
+
+test("combined path inspection preserves tracked protections and literal untracked names", () => {
+  expect(
+    inspectWindowsSnapshotPaths(
+      "H CON\0S AUX\0M PRN\0M PRN\0? spaced dir/NUL.txt\0? [abc]/CON\0? newline\nname/AUX\0? normal.txt\0",
+    ),
+  ).toEqual({
+    indexed: ["CON", "AUX", "PRN"],
+    excluded: ["spaced dir/NUL.txt", "[abc]/CON", "newline\nname/AUX"],
+  })
+  expect(inspectWindowsSnapshotPaths("")).toEqual({ indexed: [], excluded: [] })
+  expect(() => inspectWindowsSnapshotPaths("fatal: inspection failed")).toThrow("Invalid snapshot path inspection")
+})
+
+test("one tagged Git listing matches separate tracked and untracked scans, including ignore rules", async () => {
+  await using tmp = await tmpdir({ git: true })
+  const git = (args: string[]) => execFileSync("git", args, { cwd: tmp.path, encoding: "utf8" })
+  await fs.writeFile(path.join(tmp.path, "tracked.txt"), "tracked")
+  git(["add", "tracked.txt"])
+  await fs.writeFile(path.join(tmp.path, ".gitignore"), "ignored.txt\ntracked.txt\n")
+  await fs.writeFile(path.join(tmp.path, "ignored.txt"), "ignored")
+  await fs.writeFile(path.join(tmp.path, "new file.txt"), "new")
+  const separate = (args: string[]) =>
+    git(["ls-files", "-z", ...args])
+      .split("\0")
+      .filter(Boolean)
+      .sort()
+  const tagged = git(["ls-files", "-t", "-z", "--cached", "--others", "--exclude-standard"]).split("\0").filter(Boolean)
+  expect(
+    tagged
+      .filter((v) => v[0] !== "?")
+      .map((v) => v.slice(2))
+      .sort(),
+  ).toEqual(separate(["--cached"]))
+  expect(
+    tagged
+      .filter((v) => v[0] === "?")
+      .map((v) => v.slice(2))
+      .sort(),
+  ).toEqual(separate(["--others", "--exclude-standard"]))
+})
+
+test("recognizes reserved path components without rejecting valid near-matches", () => {
+  for (const name of reserved) expect(isWindowsReservedPath(name), name).toBe(true)
+  for (const name of valid) expect(isWindowsReservedPath(name), name).toBe(false)
+  expect(isWindowsReservedPath("src/AUX/data.txt")).toBe(true)
+  expect(isWindowsReservedPath("src\\con.txt\\data.txt")).toBe(true)
+  expect(isWindowsReservedPath("CON ")).toBe(true)
+})
+
+test.skipIf(process.platform !== "win32")(
+  "snapshots survive all 36 reserved paths and preserve normal-file rollback",
+  async () => {
+    await using tmp = await tmpdir({ git: true })
+    const names = reserved.map((name, i) => `case-${i}/${name}`)
+    names.push("reserved-dir/AUX/child.txt")
+    const payload = "reserved fixture content\n"
+    for (const name of names) {
+      const file = path.toNamespacedPath(path.join(tmp.path, name))
+      await fs.mkdir(path.dirname(file), { recursive: true })
+      await fs.writeFile(file, payload)
+    }
+    for (const name of valid) await fs.writeFile(path.join(tmp.path, name), "before\n")
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        const notices: string[] = []
+        const off = Bus.subscribe(NotificationEvent.ToastShow, (event) => notices.push(event.properties.message))
+        try {
+          const before = await Snapshot.track()
+          expect(before).toMatch(/^[0-9a-f]{40}$/)
+          const gitdir = path.join(Global.Path.data, "snapshot", Instance.project.id)
+          const files = execFileSync("git", ["--git-dir", gitdir, "ls-tree", "-r", "--name-only", before!], {
+            encoding: "utf8",
+          })
+            .trim()
+            .split("\n")
+            .sort()
+          expect(files).toEqual(valid.slice().sort())
+          expect(notices).toHaveLength(1)
+          expect(notices[0]).toContain("cannot be restored by rollback")
+          await fs.writeFile(path.join(tmp.path, "normal.txt"), "after\n")
+          expect(await Snapshot.track()).not.toBe(before)
+          expect(notices).toHaveLength(1)
+          await Snapshot.restore(before!)
+          expect(await fs.readFile(path.join(tmp.path, "normal.txt"), "utf8")).toBe("before\n")
+          for (const name of names) {
+            expect(await fs.readFile(path.toNamespacedPath(path.join(tmp.path, name)), "utf8")).toBe(payload)
+          }
+        } finally {
+          off()
+          await Instance.dispose()
+        }
+      },
+    })
+  },
+  60_000,
+)
+
+test.skipIf(process.platform !== "win32")(
+  "does not silently drop reserved paths from an existing snapshot index",
+  async () => {
+    await using tmp = await tmpdir({ git: true })
+    await Instance.provide({
+      directory: tmp.path,
+      fn: async () => {
+        try {
+          await Snapshot.track()
+          const gitdir = path.join(Global.Path.data, "snapshot", Instance.project.id)
+          const blob = execFileSync("git", ["--git-dir", gitdir, "hash-object", "-w", "--stdin"], {
+            input: "historical",
+            encoding: "utf8",
+          }).trim()
+          execFileSync("git", [
+            "-c",
+            "core.protectNTFS=false",
+            "--git-dir",
+            gitdir,
+            "update-index",
+            "--add",
+            "--cacheinfo",
+            `100644,${blob},CON`,
+          ])
+          await expect(Snapshot.track()).rejects.toThrow("Snapshot index contains Windows reserved paths")
+          const index = execFileSync("git", ["--git-dir", gitdir, "ls-files"], { encoding: "utf8" })
+          expect(index).toContain("CON")
+        } finally {
+          await Instance.dispose()
+        }
+      },
+    })
+  },
+)
