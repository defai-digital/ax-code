@@ -0,0 +1,36 @@
+import { Config } from "../../config/config"
+import { Instance } from "../../project/instance"
+import type { DoctorCheck } from "./doctor-health"
+
+export async function getDoctorConfiguration(directory: string): Promise<{ config?: Config.Info; check: DoctorCheck }> {
+  try {
+    // Use runtime discovery, merging, JSONC parsing and environment expansion.
+    // Standalone doctor does not otherwise have an active project instance.
+    const config = await Instance.provide({ directory, fn: () => Config.get() })
+    const count = Object.keys(config.provider ?? {}).length
+    return {
+      config,
+      check: {
+        name: "Configuration",
+        status: "ok",
+        detail: `Loaded effective configuration (${count} provider(s) configured; runtime defaults included)`,
+      },
+    }
+  } catch {
+    // Parser errors can contain config contents, including keys. Do not print them.
+    return {
+      check: {
+        name: "Configuration",
+        status: "fail",
+        detail: "Could not load effective configuration; check configuration syntax and file access",
+      },
+    }
+  }
+}
+
+export function getConfiguredCredentialProviders(config?: Config.Info): string[] {
+  return Object.entries(config?.provider ?? {})
+    .filter(([, provider]) => typeof provider.options?.apiKey === "string" && provider.options.apiKey.trim().length > 0)
+    .map(([id]) => id)
+    .sort()
+}
