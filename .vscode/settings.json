{
  // Native TypeScript 7 is the compiler and AX Code LSP backend.
  // Keep the classic SDK for editor extensions requiring the JavaScript API.
  "typescript.tsdk": "node_modules/typescript/lib",
  // Requires the TypeScript native language-service extension in VS Code.
  "js/ts.experimental.useTsgo": true,
  "rust-analyzer.linkedProjects": ["crates/Cargo.toml"]
}
