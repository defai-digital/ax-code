{
  "$schema": "https://raw.githubusercontent.com/defai-digital/ax-code/main/packages/ax-code/config.schema.json",

  // Pin models on a provider you actually have connected. Disabled plan IDs
  // (alibaba-token-plan, zai-coding-plan, …) remap to a connected gateway but
  // warn first. Qwen 3.8 Max is opt-in via /model, not the session default.
  "model": "deepseek/deepseek-v4-pro",

  // Aux lane: titles, recaps, classifier. The live DeepSeek flash SKU is
  // deepseek-flash (not deepseek-v4-flash).
  "small_model": "deepseek/deepseek-flash",

  "agent": {
    // Reasoning-dense lanes stay on Pro. This is a capability split (Pro vs
    // flash), not a required cross-provider split.
    "plan": { "model": "deepseek/deepseek-v4-pro" },
    "architect": { "model": "deepseek/deepseek-v4-pro" },
    "security": { "model": "deepseek/deepseek-v4-pro" },
    "debug": { "model": "deepseek/deepseek-v4-pro" },

    "explore": { "model": "deepseek/deepseek-flash" },
    "compaction": { "model": "deepseek/deepseek-flash" }
  },

  // Consumed only by the replanner when a plan phase fails and needs to be
  // re-planned. It does not affect general planning or the plan agent above.
  "experimental": {
    "planner_architect_model": "deepseek/deepseek-v4-pro"
  },

  "autonomous": true,
  "super_long": false,
  "isolation": {
    "mode": "full-access",
    "network": true
  },
  "modes": {
    "council": {
      "timeoutMs": 300000
    },
    "arena": {
      "enabled": true,
      "maxContestants": 3,
      "strategy": "verify_first"
    },
    "budget": {
      "maxEstimatedUsd": 0.5,
      "estimatedUsdPerMember": 0.05
    }
  }
}
